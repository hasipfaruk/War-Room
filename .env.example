# OpenAI API key for live agents. Leave empty to run in demo mode, where agent text
# is scripted but deploys, fixes and recovery measurements are still real.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Ports. HOST defaults to 127.0.0.1; only change it if you understand that the API
# can deploy code and spend API credit (see SECURITY.md).
# HOST=127.0.0.1
# SERVER_PORT=4000
# SERVICE_PORT=4001
# DASHBOARD_PORT=5173

# Where the sandbox repository and postmortems live, relative to the repo root.
# SANDBOX_DIR=sandbox/checkout-service
# POSTMORTEM_DIR=sandbox/postmortems

# Per-agent limits for live mode.
# AGENT_TIMEOUT_MS=180000
# AGENT_MAX_OUTPUT_TOKENS=16000
